# Environment Configuration for Tenant Capacity Forecaster

# Database URL: SQLite (default) or PostgreSQL
DATABASE_URL=sqlite:///./data/saas_capacity.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_capacity

# FastAPI Backend Service URL
API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI Configuration
STREAMLIT_PORT=8501
STREAMLIT_HOST=0.0.0.0

# Security & Secret key for session/token simulation
SECRET_KEY=tenant-capacity-forecaster-secret-key-32-chars-min
ALGORITHM=HS256

# Forecaster Default Settings
DEFAULT_HORIZON_DAYS=180
CONFIDENCE_THRESHOLD=0.75
URGENT_DAYS_THRESHOLD=14
SPIKE_SIGMA_THRESHOLD=5.0
